
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gift Center</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 25px 18px;
  background: #080d09;
  color: #ffffff;
  font-family: Arial, sans-serif;
}

.header {
  text-align: center;
  margin-top: 25px;
}

.header h1 {
  color: #70df89;
  letter-spacing: 3px;
}

.subtitle {
  color: #89998d;
  font-size: 13px;
}

.card {
  background: #14231a;
  border: 1px solid #285638;
  border-radius: 20px;
  padding: 23px;
  margin-top: 22px;
}

.balance {
  text-align: center;
}

.balance-number {
  font-size: 42px;
  font-weight: bold;
  color: #75e58e;
  margin: 15px 0;
}

.label {
  color: #9bac9f;
  font-size: 13px;
}

button {
  width: 100%;
  padding: 16px;
  border: none;
  border-radius: 12px;
  background: #247b40;
  color: white;
  font-size: 15px;
  font-weight: bold;
  margin-top: 15px;
}

button:active {
  background: #319b53;
}

.gift {
  display: flex;
  align-items: center;
  gap: 15px;
}

.gift-icon {
  font-size: 35px;
}

.footer {
  text-align: center;
  color: #718176;
  font-size: 11px;
  margin-top: 30px;
}
</style>
</head>

<body>

<div class="header">
  <h1>GIFT CENTER</h1>
  <div class="subtitle">Подарки и награды</div>
</div>

<div class="card balance">
  <div class="label">ТВОЙ БАЛАНС</div>
  <div class="balance-number">⭐ 100</div>
  <div class="label">Демонстрационные Stars</div>
</div>

<div class="card">
  <h3>🎁 Каталог подарков</h3>

  <div class="gift">
    <div class="gift-icon">🎁</div>
    <div>
      <b>Подарок</b>
      <div class="label">Скоро появится</div>
    </div>
  </div>

  <button onclick="showMessage()">
    Посмотреть награды
  </button>
</div>

<div class="card">
  <h3>👤 Профиль</h3>
  <div id="username">Пользователь Telegram</div>
  <div class="label" id="userstatus">
    Открой приложение через Telegram
  </div>
</div>

<div class="footer">
  GIFT CENTER · DEMO VERSION
</div>

<script>
const tg = window.Telegram.WebApp;

tg.ready();
tg.expand();

const user = tg.initDataUnsafe?.user;

if (user) {
  document.getElementById("username").textContent =
    user.first_name || "Пользователь";

  document.getElementById("userstatus").textContent =
    "Telegram подключён";
}

function showMessage() {
  tg.showAlert("Это демонстрационная версия каталога!");
}
</script>

</body>
</html>
